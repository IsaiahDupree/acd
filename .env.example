# ACD — environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit secrets.

# ─── Package layout (paths.js) ───────────────────────────────────────────────
# ACD_ROOT defaults to the package root (one level above engine/). Set only to relocate.
ACD_ROOT=/Users/isaiahdupree/Documents/Software/acd
# ACD_DATA defaults to $ACD_ROOT/data — holds features/, prds/, repo-queue.json, logs/, pids/, metrics/.
ACD_DATA=/Users/isaiahdupree/Documents/Software/acd/data
# Optional overrides (default to subdirs of ACD_DATA / ACD_ROOT):
# ACD_FEATURES=
# ACD_PRDS=
# ACD_PROMPTS=
# ACD_QUEUE=
# ACD_SCHEDULE=
# ACD_MCP_CONFIG=
# ACD_AGENTS_DIR=

# ─── Service ports ───────────────────────────────────────────────────────────
BACKEND_PORT=3434
DASHBOARD_PORT=3535
# The Next.js dashboard reads this at build/runtime to reach the backend.
NEXT_PUBLIC_BACKEND_PORT=3434
LIVE_OPS_PORT=3456
# ACTIVITY_PORT is DISABLED unless explicitly set (paths.PORTS.activity stays null).
# ACTIVITY_PORT=3457

# ─── Orchestration ───────────────────────────────────────────────────────────
# Global cap on simultaneously-running coding agents (maps to run-queue --total-slots).
ACD_MAX_CONCURRENCY=4
# Optional budget / usage guards (leave unset to disable):
# ACD_DAILY_TOKEN_BUDGET=
# ACD_DAILY_COST_BUDGET=
# ACD_BUDGET_PAUSE_MINUTES=
# ACD_USAGE_PAUSE_AT=
# ACD_USAGE_STOP_AT=
# ACD_USAGE_CHECK_INTERVAL=
# ACD_MAX_AUTH_FAILURES=
# RATE_LIMIT_WAIT_MINUTES=

# ─── Claude Code auth ────────────────────────────────────────────────────────
# The engine spawns the `claude` CLI with OAuth. It STRIPS ANTHROPIC_API_KEY from the
# child env and forwards CLAUDE_CODE_OAUTH_TOKEN. Use the OAuth token, not an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY is intentionally NOT used to spawn agents (stripped). Leave unset.
# ANTHROPIC_API_KEY=

# ─── Supabase (shared project) ───────────────────────────────────────────────
SUPABASE_URL=https://ivhfuhxorppptyuofbgq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Used by the supabase MCP server (.mcp.json) — a Supabase personal access token.
SUPABASE_ACCESS_TOKEN=

# ─── Metrics database (engine/metrics-db.js, Postgres) ───────────────────────
# Full connection string OR the discrete METRICS_DB_* fields below.
DATABASE_URL=
# METRICS_DB_HOST=
# METRICS_DB_PORT=5432
# METRICS_DB_NAME=
# METRICS_DB_USER=
# METRICS_DB_PASSWORD=

# ─── Externalized service URLs (do not hardcode in source) ───────────────────
# CRMLite REST API (CRM sync from spawned agents / orchestrator).
CRMLITE_URL=https://crmlite-isaiahduprees-projects.vercel.app
# ACTP worker REST API.
WORKER_URL=http://localhost:8090
# Shared secret for authenticating to the worker.
WORKER_SECRET=

# ─── MCP server credentials (.mcp.json placeholders) ─────────────────────────
VERCEL_TOKEN=
PERPLEXITY_API_KEY=
OBSIDIAN_API_KEY=
OBSIDIAN_BASE_URL=http://127.0.0.1:27123

# ─── Memory / business goals (optional) ──────────────────────────────────────
# MEMORY_VAULT_PATH=/Users/isaiahdupree/.memory/vault
# GOALS_PATH=/Users/isaiahdupree/Documents/Software/business-goals.json
# SOFTWARE_ROOT=/Users/isaiahdupree/Documents/Software

# ─── Telegram notifications (optional) ───────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
